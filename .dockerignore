# Railway builds Dockerfile.railway from a full source checkout.
# Exclude only what isn't needed by the build (heavy dirs, caches, build outputs).

# VCS / CI / editor
.git
.github
.husky
.devcontainer
.vscode
.idea
.cursor
.claude

# Docs and non-runtime sites
microsite
docs
docs-ui
beps
contrib
blitzy
proposals
.storybook
.changeset

# Yarn working state (keep releases/ and patches/, drop caches)
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/sdks

# Node deps and build outputs
node_modules
**/node_modules
packages/*/dist
packages/*/dist-types
packages/*/coverage
plugins/*/dist
plugins/*/dist-types
plugins/*/coverage
coverage
.nyc_output
*.tsbuildinfo

# Local env and OS cruft
.env
.env.local
.env.*.local
*.log
.DS_Store
