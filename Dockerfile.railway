# ---- Stage 1: Build ----
FROM node:22-trixie-slim AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends libsqlite3-dev python3 python3-pip python3-venv build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# Copy Yarn 4 config and lockfile first for better caching
COPY .yarn ./.yarn
COPY .yarnrc.yml ./
COPY yarn.lock package.json tsconfig.json ./

# Copy all workspace package.json files needed for install
COPY packages/ ./packages/
COPY plugins/ ./plugins/

# Root app-config files. The frontend bundle (built as part of
# `yarn workspace example-backend build`) templates index.html with
# values from app-config (e.g. app.title), so they must be present at
# build time, not just at runtime.
COPY app-config.yaml app-config.production.yaml ./

# Install all dependencies (including devDependencies for build)
RUN YARN_ENABLE_GLOBAL_CACHE=false yarn install --immutable

# Run TypeScript compilation and backend build.
# `yarn tsc` only emits .d.ts files into dist-types/ for the dev workflow;
# the backend bundle (next line) uses SWC and does not consume them. The
# `|| true` tolerates the codebase's known pre-existing type errors so a
# bad type doesn't block deploys — matches the convention from the previous
# multi-stage Dockerfile before #23.
RUN yarn tsc || true
RUN yarn workspace example-backend build

# ---- Stage 2: Production ----
FROM node:22-trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libsqlite3-dev python3 python3-pip python3-venv build-essential && \
    rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip3 install mkdocs-techdocs-core==1.1.7 mkdocs-mermaid2-plugin

# /data is where SQLite lives (configured in app-config.railway.yaml). Railway
# mounts a fresh persistent volume on top of /data at runtime, owned by root —
# so the previous `USER node` setup couldn't write to it. Run as root (same as
# Dockerfile.dev and Dockerfile.localgcp in this repo) to avoid the volume
# permission mismatch.
RUN mkdir -p /data

WORKDIR /app

ENV NODE_ENV=production

COPY .yarn ./.yarn
COPY .yarnrc.yml ./
COPY --from=build /app/packages/backend/dist/skeleton.tar.gz /app/yarn.lock /app/package.json ./
RUN tar xzf skeleton.tar.gz && rm skeleton.tar.gz

RUN YARN_ENABLE_GLOBAL_CACHE=false yarn workspaces focus --all --production

RUN mkdir -p /tmp/sqlite3 && cd /tmp/sqlite3 && npm init -y && npm install better-sqlite3@11.10.0 && \
    cp -r node_modules/better-sqlite3 /app/node_modules/ && \
    { cp -r node_modules/bindings /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/file-uri-to-path /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/prebuild-install /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/node-addon-api /app/node_modules/ 2>/dev/null || true; } && \
    rm -rf /tmp/sqlite3

COPY --from=build /app/packages/backend/dist/bundle.tar.gz ./
COPY app-config.yaml app-config.railway.yaml ./
COPY catalog-blitzy-sandbox.yaml ./
COPY catalog-blitzy-public-samples.yaml ./
COPY packages/app/app-config.yaml ./packages/app/app-config.yaml
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz

WORKDIR /app/packages/backend

EXPOSE 7007

CMD ["node", ".", "--config", "../../app-config.yaml", "--config", "../../app-config.railway.yaml", "--config", "../app/app-config.yaml"]
